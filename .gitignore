# ---------------------------------------------------------------------------
# Secrets and credential stores. NEVER commit these.
# ---------------------------------------------------------------------------
# All real secret material lives in connection/.secrets/ (owner-only ACL/chmod 700):
#   backend.env      Django SECRET_KEY, FERNET_KEY, Intuit client ID/secret
#   mcp-server.env   token store generated for the MCP server (rotating refresh token)
#   db.sqlite3       encrypted refresh tokens + audit log
connection/.secrets/
.secrets/

# Any real .env file anywhere; only *.env.example templates are tracked.
.env
.env.*
*.env
!.env.example
!*.env.example

# Databases (may hold encrypted tokens and audit data)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db

# Key material and token dumps
*.pem
*.key
*.p12
*.pfx
tokens.json

# Unredacted evidence: capture raw output here, commit only the redacted copies.
connection/evidence/raw/
connection/evidence/**/*.raw.*
capture-*.txt

# Evaluation runs: large raw artifacts (streams, skill outputs) stay local. The committed record is
# evals/baseline/ (a verbatim copy of the baseline run) plus the first run's report, results and NOTE.
evals/runs/*
!evals/runs/first-run-20261012/
evals/runs/first-run-20261012/*
!evals/runs/first-run-20261012/report.md
!evals/runs/first-run-20261012/results.json
!evals/runs/first-run-20261012/NOTE.md
# commit-4 run: recorded as an honest FAIL (blocked by the regression policy)
!evals/runs/commit4-run-20261012/
evals/runs/commit4-run-20261012/*
!evals/runs/commit4-run-20261012/report.md
!evals/runs/commit4-run-20261012/results.json
!evals/runs/commit4-run-20261012/NOTE.md
# commit-5 run: recorded as an honest FAIL (case g R1; grader noise, see its NOTE)
