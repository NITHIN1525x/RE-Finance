#!/usr/bin/env python
"""Secret scanner for this repo. Reports file:line + rule + a fingerprint, NEVER the secret value.

Usage:
    python connection/scripts/secret_scan --staged      # what the pre-commit hook runs
    python connection/scripts/secret_scan --all         # tracked + untracked, non-ignored files
    python connection/scripts/secret_scan PATH [PATH..] # specific files/dirs (ignores .gitignore)

Options:
    --secrets-dir DIR    where the real local secrets live (default: connection/.secrets)
    --no-known-values    skip the known-value check (below)

Known-value check (on by default when the secrets dir exists): every scanned file outside the secrets dir is
also searched for the actual values in DIR/*.env (credential-named keys only). A hit is reported as
`known-secret:<KEY>`, with no value, fingerprint or surrounding text.

Anything found in or taken from a .secrets/ directory is reported as path, line (text) or byte offset
(binary), and rule ONLY: no fingerprint, no excerpt (DECISIONS_LOG D-53). Binary files inside .secrets/
are scanned too, by offset. Use this script, never an ad-hoc script, to look for secrets.

Exit codes: 0 clean, 1 findings, 2 usage/git error.

False positive? Append the pragma `secret-scan: allow` to that line, with a comment saying why.
"""
import hashlib
import math
import os
import re
import subprocess
import sys
from pathlib import Path

ALLOW_PRAGMA = "secret-scan: allow"

# Files that must never be committed regardless of their contents.
FORBIDDEN_PATHS = [
    (re.compile(r"(^|/)\.secrets/"), "secrets-directory"),
    (re.compile(r"(^|/)(\.env|[^/]*\.env|\.env\.[^/]+)$"), "real-env-file"),
    (re.compile(r"\.sqlite3(-journal|-wal|-shm)?$|\.db$"), "database-file"),
    (re.compile(r"\.(pem|key|p12|pfx)$"), "key-file"),
    (re.compile(r"(^|/)tokens\.json$"), "token-dump"),
    (re.compile(r"(^|/)evidence/raw/"), "unredacted-evidence"),
]
TEMPLATE_OK = re.compile(r"\.env\.example$|\.example$")

# Value-shape rules: match the secret itself wherever it appears.
VALUE_RULES = [
    # Intuit OAuth access tokens are JWT/JWE (base64url JSON header starting "eyJ").
    ("jwt-or-access-token", re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_.-]{20,}")),
    # Intuit refresh tokens look like AB11<~46 alphanumerics>; client IDs start with AB too.
    ("intuit-token-or-client-id", re.compile(r"\bAB[0-9A-Za-z]{2}[A-Za-z0-9]{38,}\b")),
    # Fernet ciphertext (an encrypted refresh token) always starts with version byte 0x80 => "gAAAAA".
    ("fernet-ciphertext", re.compile(r"\bgAAAAA[A-Za-z0-9_-]{40,}={0,2}")),
    ("django-insecure-key", re.compile(r"django-insecure-[^\s'\"]{20,}")),
    ("private-key-block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
]

# Assignment rules: NAME = value, where NAME looks credential-ish and value looks real.
CRED_NAME = re.compile(
    r"""(?ix)
    (?P<name>[A-Z0-9_.-]*(?:SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_?KEY|FERNET|CLIENT_?ID)[A-Z0-9_.-]*)
    ["']?\s*(?::|=|:=)\s*
    (?P<q>["']?)(?P<value>[^\s"'#,;}{)\\]+)
    """
)
FERNET_KEY_SHAPE = re.compile(r"^[A-Za-z0-9_-]{43}=$")
PLACEHOLDER = re.compile(
    r"""(?ix)^(
        your[_-].*|<.*>|\$\{.*\}|\$\w+|%\w+%|changeme|change[_-]me|example.*|placeholder.*|xxx+|\*+|
        none|null|true|false|undefined|redacted.*|\[redacted\]|todo|fake.*|dummy.*|test.*|sample.*|
        generated[_-].*|set|unset|empty|""|''
    )$"""
)
# Values that are code, not literals (os.environ[...], settings.X, process.env.X, function calls...).
CODE_REF = re.compile(r"(\(|\)|\[|\]|^os\.|^settings\.|^process\.|^self\.|^env\.|^config\.|^request\.|\.get$"
                      r"|^[A-Za-z_]\w*(\.[A-Za-z_]\w*)+$)")          # dotted attribute chains: Model.Owner.MCP
# URLs / host paths with no embedded credentials (no user:pass@). Token-shaped query values are still
# caught by VALUE_RULES on the same line.
URL_LIKE = re.compile(r"^`?(https?://)?[A-Za-z0-9.-]+\.[A-Za-z]{2,}(:\d+)?(/[^\s@]*)?`?$")

SECRETS_PATH = re.compile(r"(^|/)\.secrets/")
DEFAULT_SECRETS_DIR = Path(__file__).resolve().parent.parent / ".secrets"
# Keys in DIR/*.env whose values are checked for verbatim elsewhere (names are not secret; values are).
KNOWN_KEY = re.compile(r"(?i)SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE|FERNET|CLIENT_?ID|REALM")
KNOWN_MIN_LEN = 8

SKIP_DIRS = {".git", "node_modules", "dist", "build", "__pycache__", ".venv", "venv", ".pytest_cache", "coverage"}
MAX_BYTES = 2_000_000


def fingerprint(value):
    """Non-reversible hint so a human can tell findings apart without seeing the secret."""
    return f"len={len(value)} sha256={hashlib.sha256(value.encode()).hexdigest()[:8]}"


def entropy(s):
    if not s:
        return 0.0
    counts = {c: s.count(c) for c in set(s)}
    return -sum(n / len(s) * math.log2(n / len(s)) for n in counts.values())


def looks_like_real_value(name, value):
    if PLACEHOLDER.match(value) or CODE_REF.search(value) or URL_LIKE.match(value):
        return False
    if "FERNET" in name.upper() and FERNET_KEY_SHAPE.match(value):
        return True
    # Short or low-entropy values are usually flags, names or env-var references.
    return len(value) >= 16 and entropy(value) >= 3.5


def scan_text(path, text):
    findings = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if ALLOW_PRAGMA in line:
            continue
        seen = set()
        for rule, rx in VALUE_RULES:
            for m in rx.finditer(line):
                findings.append((path, lineno, rule, fingerprint(m.group(0))))
                seen.add(m.group(0))
        for m in CRED_NAME.finditer(line):
            name, value = m.group("name"), m.group("value")
            if any(value in s or s in value for s in seen):
                continue  # already reported by a value rule
            if looks_like_real_value(name, value):
                findings.append((path, lineno, f"credential-assignment:{name}", fingerprint(value)))
        # Bare Fernet keys (44 chars ending "=") on a line that mentions a key.
        if re.search(r"(?i)fernet|encrypt|key", line):
            for m in re.finditer(r"(?<![A-Za-z0-9_-])[A-Za-z0-9_-]{43}=(?![A-Za-z0-9=])", line):
                if m.group(0) not in seen and entropy(m.group(0)) >= 4.0:
                    findings.append((path, lineno, "fernet-key-shape", fingerprint(m.group(0))))
    return findings


def in_secrets(path):
    return bool(SECRETS_PATH.search(str(path).replace("\\", "/")))


def scan_binary(path, data):
    """Value-shape rules over raw bytes (e.g. a SQLite file in .secrets/). Reports byte offsets only."""
    text = data.decode("latin-1")
    return [(path, f"@{m.start()}", rule, None) for rule, rx in VALUE_RULES for m in rx.finditer(text)]


def load_known_values(secrets_dir):
    """[(key, source file name, value)] from DIR/*.env. Values stay in memory and are never printed."""
    known = []
    d = Path(secrets_dir)
    if not d.is_dir():
        return known
    for f in sorted(d.glob("*.env")):
        for raw in f.read_text(encoding="utf-8", errors="replace").splitlines():
            key, sep, value = raw.strip().partition("=")
            key, value = key.strip(), value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            if sep and not key.startswith("#") and KNOWN_KEY.search(key) and len(value) >= KNOWN_MIN_LEN:
                known.append((key, f.name, value))
    return known


def scan_known(path, text, known):
    findings = []
    for key, source, value in known:
        start = text.find(value)
        while start != -1:
            findings.append((path, text.count("\n", 0, start) + 1, f"known-secret:{key} (from {source})", None))
            start = text.find(value, start + 1)
    return findings


def check_path_rules(relpath):
    p = relpath.replace("\\", "/")
    if TEMPLATE_OK.search(p):
        return []
    return [(relpath, 0, f"forbidden-file:{rule}", "path") for rx, rule in FORBIDDEN_PATHS if rx.search(p)]


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def staged_files():
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z")
    return [f for f in out.decode().split("\0") if f]


def all_repo_files():
    # Tracked + untracked-but-not-ignored. Submodules are listed as a path, not descended into.
    out = git("ls-files", "-co", "--exclude-standard", "-z")
    return [f for f in out.decode().split("\0") if f and os.path.isfile(f)]


def walk(paths):
    for p in map(Path, paths):
        if p.is_file():
            yield str(p)
        elif p.is_dir():
            for root, dirs, files in os.walk(p):
                dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
                for f in files:
                    yield os.path.join(root, f)


def read_bytes(path, staged):
    return git("show", f":{path}") if staged else Path(path).read_bytes()


def parse_args(argv):
    opts = {"secrets_dir": DEFAULT_SECRETS_DIR, "known": True, "targets": []}
    it = iter(argv)
    for a in it:
        if a == "--secrets-dir":
            opts["secrets_dir"] = Path(next(it, ""))
        elif a == "--no-known-values":
            opts["known"] = False
        else:
            opts["targets"].append(a)
    return opts


def main(argv):
    opts = parse_args(argv)
    targets = opts["targets"]
    if not targets or targets[0] in ("-h", "--help"):
        print(__doc__)
        return 2
    staged = targets[0] == "--staged"
    known = load_known_values(opts["secrets_dir"]) if opts["known"] else []
    try:
        if staged:
            files = staged_files()
        elif targets[0] == "--all":
            files = all_repo_files()
        else:
            files = list(walk(targets))
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print(f"secret_scan: git error ({exc.__class__.__name__})", file=sys.stderr)
        return 2

    findings = []
    for f in files:
        findings += check_path_rules(f)
        try:
            data = read_bytes(f, staged)
        except (OSError, subprocess.CalledProcessError):
            continue
        secret_file = in_secrets(f)
        if b"\0" in data[:8192]:  # binary: only scanned inside .secrets/, by offset
            if secret_file:
                findings += scan_binary(f, data)
            continue
        if len(data) > MAX_BYTES:
            continue
        text = data.decode("utf-8", errors="replace")
        findings += scan_text(f, text)
        if known and not secret_file:
            findings += scan_known(f, text, known)

    for path, line, rule, fp in findings:
        loc = f"{path}{line}" if isinstance(line, str) else f"{path}:{line}" if line else path
        # .secrets/ sources and known-value hits: location and rule only, nothing derived from the value.
        show_fp = fp not in (None, "path") and not in_secrets(path)
        print(f"SECRET? {loc}  rule={rule}" + (f"  [{fp}]" if show_fp else ""))
    if findings:
        print(f"\nsecret_scan: {len(findings)} finding(s) in {len(files)} file(s). Values are not shown.\n"
              f"Remove the secret (and rotate it if it was ever committed), or add '{ALLOW_PRAGMA}' "
              f"to a line that is a verified false positive.", file=sys.stderr)
        return 1
    print(f"secret_scan: clean ({len(files)} file(s) scanned)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
