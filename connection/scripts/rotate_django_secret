#!/usr/bin/env python
"""Rotate the Django SECRET_KEY and revoke every session. Prints counts and booleans only, never a value.

Run with the backend's venv, with the Django server stopped:
    connection/backend/.venv/Scripts/python connection/scripts/rotate_django_secret

What it does:
  1. Deletes every row in django_session (every logged-in browser must log in again).
  2. Writes a new random DJANGO_SECRET_KEY into the backend env file, in place, so the file keeps its
     owner-only permissions. No SECRET_KEY_FALLBACKS are kept, so anything signed with the old key is dead.
  3. Verifies in a fresh process: the new key is loaded, it differs from the old one, no sessions remain, and
     none of the old session keys loads.

It does not touch FERNET_KEY or the QuickBooks tokens (DECISIONS_LOG D-53).
"""
import hashlib
import json
import os
import secrets
import subprocess
import sys
from pathlib import Path

BACKEND = Path(__file__).resolve().parent.parent / "backend"


def setup_django():
    sys.path.insert(0, str(BACKEND))
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "config.settings")
    import django
    django.setup()


def digest(value):
    return hashlib.sha256(value.encode()).hexdigest()


def verify(old_digest, old_session_keys):
    setup_django()
    from django.conf import settings
    from django.contrib.sessions.backends.db import SessionStore
    from django.contrib.sessions.models import Session
    return {
        "key_changed": digest(settings.SECRET_KEY) != old_digest,
        "no_fallback_keys": not getattr(settings, "SECRET_KEY_FALLBACKS", []),
        "sessions_remaining": Session.objects.count(),
        "old_sessions_loadable": sum(SessionStore().exists(k) for k in old_session_keys),
    }


def main():
    if "--verify" in sys.argv:  # child process: fresh settings, reads its inputs from stdin
        data = json.load(sys.stdin)
        print(json.dumps(verify(data["old_digest"], data["old_session_keys"])))
        return 0

    setup_django()
    from django.conf import settings
    from django.contrib.sessions.models import Session
    from config.settings import ENV_FILE

    old_digest = digest(settings.SECRET_KEY)
    old_keys = list(Session.objects.values_list("session_key", flat=True))
    deleted, _ = Session.objects.all().delete()

    lines = Path(ENV_FILE).read_text(encoding="utf-8").splitlines(keepends=True)
    hits = [i for i, l in enumerate(lines) if l.split("=", 1)[0].strip() == "DJANGO_SECRET_KEY"]
    if len(hits) != 1:
        print(f"rotate_django_secret: expected exactly one DJANGO_SECRET_KEY line, found {len(hits)}; nothing written")
        return 2
    eol = "\r\n" if lines[hits[0]].endswith("\r\n") else "\n"
    lines[hits[0]] = f"DJANGO_SECRET_KEY={secrets.token_urlsafe(50)}{eol}"
    with open(ENV_FILE, "r+", encoding="utf-8", newline="") as f:  # in place: keeps the file's ACL
        f.seek(0)
        f.write("".join(lines))
        f.truncate()

    env = {k: v for k, v in os.environ.items() if k != "DJANGO_SECRET_KEY"}  # child must read the new file value
    r = subprocess.run([sys.executable, __file__, "--verify"], input=json.dumps(
        {"old_digest": old_digest, "old_session_keys": old_keys}), capture_output=True, text=True, env=env)
    if r.returncode != 0:
        print("rotate_django_secret: verification process failed (stderr suppressed; it may contain settings)")
        return 1
    result = json.loads(r.stdout)
    print(f"sessions deleted: {deleted}")
    for k, v in result.items():
        print(f"{k}: {v}")
    ok = result["key_changed"] and result["no_fallback_keys"] and not result["sessions_remaining"] \
        and not result["old_sessions_loadable"]
    print("rotation verified" if ok else "rotation NOT verified")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
