# Template only. The REAL file is connection/.secrets/mcp-server.env, written by
#   python manage.py export_mcp_env --client <slug>
# and passed to the official server via QUICKBOOKS_TOKEN_STORE_PATH (set by connection/scripts/mcp_launch.mjs).
# Do not edit the real file by hand: the MCP server rewrites it whenever Intuit rotates the refresh token.
# Variable names verified against quickbooks-online-mcp-server@31a1dd5 (src/clients/quickbooks-client.ts,
# src/helpers/register-tool.ts).

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Restriction mode. The server only honours the exact lowercase string "true".
QUICKBOOKS_DISABLE_WRITE=true
QUICKBOOKS_DISABLE_UPDATE=true
QUICKBOOKS_DISABLE_DELETE=true
