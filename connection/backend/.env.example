# Template only. The REAL file is connection/.secrets/backend.env (git-ignored, owner-only ACL).
# Create it with:  python connection/scripts/init_secrets.py
# Never put real values in this file.

# Django
DJANGO_SECRET_KEY=<generated-by-init_secrets>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key that encrypts refresh tokens at rest. Generated locally; never stored in the DB or Git.
FERNET_KEY=<generated-by-init_secrets>

# Intuit app "Development" keys (Intuit Developer Portal > your app > Keys & credentials).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Sandbox only. The backend refuses to start with any other value.
QUICKBOOKS_ENVIRONMENT=sandbox

# Must match a Redirect URI registered on the Intuit app EXACTLY.
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/qbo/callback

# Where the browser is sent after the OAuth callback (Vite dev server).
FRONTEND_URL=http://localhost:5173
