# Index of environment files for this repo. Templates only: no real values anywhere in Git.
#
# Real files (all git-ignored, inside the owner-only directory connection/.secrets/):
#   connection/.secrets/backend.env     <- template: connection/backend/.env.example
#   connection/.secrets/mcp-server.env  <- template: connection/mcp-server.env.example (generated, do not hand-edit)
#
# Bootstrap both with:   python connection/scripts/init_secrets.py
# The only values a human enters are QUICKBOOKS_CLIENT_ID / QUICKBOOKS_CLIENT_SECRET in backend.env.

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
